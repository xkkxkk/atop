# ── Application ──────────────────────────────────────────────────────────
PORT=8080
APP_ENV=production          # development | production
LOG_LEVEL=info              # debug | info | warn | error
ADMIN_EMAIL=admin@atop.local
ADMIN_PASSWORD=Admin@123456  # Change this on first boot!

# ── Database ──────────────────────────────────────────────────────────────
# Option A: full DSN string
# DB_DSN=root:password@tcp(localhost:3306)/atop?charset=utf8mb4&parseTime=True&loc=Local

# Option B: individual fields (used when DB_DSN is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=atop
DB_PASSWORD=your_db_password
DB_NAME=atop

# Connection pool (production tuning)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_MINUTES=10
DB_SLOW_THRESHOLD_MS=200    # log queries slower than this

# ── Security ──────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_ACCESS_TTL_HOURS=8
JWT_REFRESH_TTL_DAYS=7
AUTH_SINGLE_SESSION_ENABLED=false

AES_KEY=change-this-to-a-random-32-char-string   # for encrypting Jenkins tokens

WEBHOOK_HMAC_SECRET=change-this-webhook-secret   # for Jenkins callback verification

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=*    # In production: https://your-frontend-domain.com

# ── Jenkins ───────────────────────────────────────────────────────────────
JENKINS_TIMEOUT_SECONDS=10
JENKINS_MAX_CONCURRENT=20
JENKINS_RETRY_COUNT=3
JENKINS_RETRY_WAIT_SECONDS=30
