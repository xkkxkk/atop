MYSQL_ROOT_PASSWORD=RootPass@123
DB_PASSWORD=AtopDB@2025

# Required secrets
JWT_SECRET=please-change-this-to-a-random-64-char-string-in-production
AES_KEY=please-change-this-aes-key-32chars
WEBHOOK_HMAC_SECRET=please-change-this-webhook-secret

# Initial admin account
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=#PassW0rd

# Public backend URL, used by email links and secure-cookie inference
EXTERNAL_URL=https://your-api-domain.com

# Jenkins callback base URL
WEBHOOK_BASE_URL=https://your-api-domain.com

# SMTP for forgot-password and notification emails
# QQ邮箱：先在 QQ 邮箱设置里开启 POP3/SMTP 或 IMAP/SMTP，并生成授权码。
# SMTP_PASS 填授权码，不是 QQ 登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_number@qq.com
SMTP_PASS=your_qq_mail_authorization_code
SMTP_FROM=your_qq_number@qq.com
# auto | ssl | starttls | none
# QQ邮箱 465 用 ssl；公司 Outlook/Exchange 587 通常用 starttls。
SMTP_SECURITY=ssl

# Token TTL
JWT_ACCESS_TTL_HOURS=8
JWT_REFRESH_TTL_DAYS=7

# CORS for split frontend/backend deployment
# Use explicit frontend origins in production, comma-separated
CORS_ALLOW_ORIGINS=https://your-frontend-domain.com,http://47.108.197.129:8888
CORS_ALLOW_CREDENTIALS=true

# Refresh-token cookie options
# COOKIE_SAME_SITE: lax | strict | none
# COOKIE_SECURE: auto | true | false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=auto
